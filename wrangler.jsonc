{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "soilsense",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Dashboard (built by `npm run build:web`) is served as static assets.
  // API and Twilio webhooks always run in the Worker first.
  "assets": {
    "directory": "./dist/web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/voice/*", "/voice-agent", "/healthz"]
  },

  // Cache for NASA / USDA responses + call log.
  // Create with: npx wrangler d1 create fieldshift  → paste the database_id below.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fieldshift",
      "database_id": "133cd4a3-101c-430f-9db0-e93e15e88927",
      "migrations_dir": "migrations"
    }
  ],

  // Workers AI powers the "Ask about this plan" answers and optional plan rewording.
  // Everything still works without it (deterministic templates are the fallback).
  "ai": { "binding": "AI" },

  // Caps public Scout chat use (Gemini calls cost money): per visitor IP, per minute.
  "ratelimits": [{ "name": "SCOUT_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }],

  // Live room: one SQLite-backed Durable Object (works on the Free plan). Field Watch and calls publish to it.
  "durable_objects": {
    "bindings": [
      { "name": "LIVE_ROOM", "class_name": "LiveRoom" },
      // Field Watch agents (Agents SDK): one SQLite-backed instance per watched field; schedules and keeps its checks.
      { "name": "FIELD_AGENT", "class_name": "FieldAgent" }
    ]
  },
  "migrations": [
    { "tag": "v1-live-room", "new_sqlite_classes": ["LiveRoom"] },
    { "tag": "v2-field-agent", "new_sqlite_classes": ["FieldAgent"] }
  ],

  // Field Watch: check every watched field each hour in the background (scheduled() in src/worker/index.ts).
  "triggers": { "crons": ["17 * * * *", "43 5 * * *"] },

  // NASA POWER snapshot refresh: daily at 05:43 UTC (second cron above) and POST /api/refresh/run (ADMIN_TOKEN).
  "workflows": [{ "name": "soilsense-power-refresh", "binding": "POWER_REFRESH", "class_name": "PowerRefreshWorkflow" }, { "name": "soilsense-imerg-refresh", "binding": "IMERG_REFRESH", "class_name": "ImergRefreshWorkflow" }],

  // Immutable, content-addressed evidence bundles. Create with: npx wrangler r2 bucket create soilsense-evidence
  "r2_buckets": [{ "binding": "EVIDENCE", "bucket_name": "soilsense-evidence" }],

  // Cited research passages (#7). Create the index + metadata indexes BEFORE ingesting: see docs/RESEARCH.md.
  "vectorize": [{ "binding": "RESEARCH_INDEX", "index_name": "soilsense-research-v1" }],

  "vars": {
    "AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "TWILIO_VALIDATE": "true",
    "HISTORY_START_YEAR": "1991"
  }
  // Secrets (set with `npx wrangler secret put NAME`, or .dev.vars locally):
  //   TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_FROM_NUMBER (optional),
  //   NASS_API_KEY (optional, USDA Quick Stats), PUBLIC_BASE_URL (optional),
  //   ADMIN_TOKEN (optional, protects GET /api/logs)
  //   GEMINI_API_KEY (Scout chat agent), GEMINI_MODEL (optional)
}
