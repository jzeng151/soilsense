{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "soilsense",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Dashboard (built by `npm run build:web`) is served as static assets.
  // API and Twilio webhooks always run in the Worker first.
  "assets": {
    "directory": "./dist/web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/voice/*", "/voice-agent", "/healthz"]
  },

  // Cache for NASA / USDA responses + call log.
  // Create with: npx wrangler d1 create fieldshift  → paste the database_id below.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fieldshift",
      "database_id": "133cd4a3-101c-430f-9db0-e93e15e88927",
      "migrations_dir": "migrations"
    }
  ],

  // Offline dev config: identical to wrangler.jsonc but without the Workers AI binding,
  // so `npm run dev:offline` works without a Cloudflare login. "Ask" falls back to fact matching.

  // Live room: one SQLite-backed Durable Object (works on the Free plan). Field Watch and calls publish to it.
  "durable_objects": { "bindings": [{ "name": "LIVE_ROOM", "class_name": "LiveRoom" }] },
  "migrations": [{ "tag": "v1-live-room", "new_sqlite_classes": ["LiveRoom"] }],

  // Field Watch: check every watched field each hour in the background (scheduled() in src/worker/index.ts).
  "triggers": { "crons": ["17 * * * *", "43 5 * * *"] },

  // NASA POWER snapshot refresh: daily at 05:43 UTC (second cron above) and POST /api/refresh/run (ADMIN_TOKEN).
  "workflows": [{ "name": "soilsense-power-refresh", "binding": "POWER_REFRESH", "class_name": "PowerRefreshWorkflow" }],

  // Immutable, content-addressed evidence bundles. Create with: npx wrangler r2 bucket create soilsense-evidence
  "r2_buckets": [{ "binding": "EVIDENCE", "bucket_name": "soilsense-evidence" }],

  "vars": {
    "AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "TWILIO_VALIDATE": "true",
    "HISTORY_START_YEAR": "1991"
  }
  // Secrets (set with `npx wrangler secret put NAME`, or .dev.vars locally):
  //   TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_FROM_NUMBER (optional),
  //   NASS_API_KEY (optional, USDA Quick Stats), PUBLIC_BASE_URL (optional),
  //   ADMIN_TOKEN (optional, protects GET /api/logs)
}
