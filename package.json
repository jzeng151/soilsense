{
  "name": "soilsense",
  "version": "1.0.0",
  "private": true,
  "description": "SoilSense: climate-aware crop rotation advisor for US farms, built on NASA Earth observations (NASA Space Apps 2026, Field Shift challenge).",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "npm run build:web && wrangler dev",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "build": "npm run build:web",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply fieldshift --local -c wrangler.offline.jsonc",
    "db:migrate:remote": "wrangler d1 migrations apply fieldshift --remote",
    "deploy": "npm run build:web && wrangler deploy",
    "prefetch": "node scripts/prefetch-demo.mjs",
    "dev:offline": "npm run build:web && wrangler dev -c wrangler.offline.jsonc"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.121",
    "@ai-sdk/react": "^4.0.177",
    "agents": "^0.33.0",
    "ai": "^7.0.173",
    "hono": "^4.13.18",
    "htmlparser2": "^12.0.0",
    "leaflet": "^1.9.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "workers-ai-provider": "^4.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261114.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "happy-dom": "^21.0.4",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.162.0"
  }
}
